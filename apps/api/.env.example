# Database (SQLite — file-based, kein externer DB-Server nötig)
DATABASE_URL="file:./data/kore.db"

# JWT
JWT_SECRET="your-jwt-secret-min-32-chars-here"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars-here"

# Resend API Key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# E-Mail-Adresse für Benachrichtigungen
NOTIFICATION_EMAIL=hello@kore-retail.de

# Absender-E-Mail (muss in Resend verifiziert sein)
FROM_EMAIL=noreply@kore-retail.de

# CORS Origin — In Production nicht nötig (Same-Origin).
# Nur für lokale Entwicklung relevant (Vite Dev-Server).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Server
PORT=3001
NODE_ENV=production
