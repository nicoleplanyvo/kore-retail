# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/kore?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-min-32-chars-here"
JWT_REFRESH_SECRET="your-refresh-secret-min-32-chars-here"

# Resend API Key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# E-Mail-Adresse für Benachrichtigungen
NOTIFICATION_EMAIL=hello@planyvo.com

# Absender-E-Mail (muss in Resend verifiziert sein)
FROM_EMAIL=noreply@koreretail.de

# CORS Origin (Frontend-URL, kommagetrennt für mehrere)
CORS_ORIGIN=https://koreretail.de,https://www.koreretail.de,https://dashboard.kore-retail.de

# Server Port
PORT=3001
