generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "sqlite"
}

// === Models ===

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("learner")
  tenantId     String?
  tenant       Tenant?   @relation(fields: [tenantId], references: [id])
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  storeAssignments UserStoreAssignment[]

  @@index([tenantId])
}

model Tenant {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  status       String    @default("ACTIVE")
  contactEmail String?
  contactName  String?
  contactPhone String?
  maxUsers     Int       @default(15)
  logoUrl      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  users        User[]
  stores       Store[]
  subscription Subscription?
  consents     DataProcessingConsent[]
}

model Store {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  city      String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tools     StoreToolAssignment[]
  userAssignments UserStoreAssignment[]
  auditSessions   AuditSession[]

  @@index([tenantId])
}

model ToolDefinition {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String?
  category     String
  icon         String?
  priceMonthly Int      @default(0)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignments  StoreToolAssignment[]

  @@index([category])
}

model StoreToolAssignment {
  id         String   @id @default(cuid())
  storeId    String
  store      Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  toolId     String
  tool       ToolDefinition @relation(fields: [toolId], references: [id], onDelete: Cascade)
  isActive   Boolean  @default(true)
  assignedAt DateTime @default(now())
  config     String?

  @@unique([storeId, toolId])
  @@index([storeId])
  @@index([toolId])
}

model UserStoreAssignment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
}

model Subscription {
  id               String    @id @default(cuid())
  tenantId         String    @unique
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  stripeCustomerId String    @unique
  stripeSubId      String    @unique
  status           String
  currentPeriodEnd DateTime
  cancelAtPeriod   Boolean   @default(false)
}

// GDPR: Audit-Log für Datenänderungen
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  userId     String?
  action     String
  entity     String
  entityId   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
  @@index([entity, entityId])
}

// GDPR: Data Processing Agreement Tracking
model DataProcessingConsent {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  consentType String
  grantedAt   DateTime  @default(now())
  grantedBy   String
  revokedAt   DateTime?
  revokedBy   String?
  version     String
  document    String?

  @@index([tenantId])
  @@unique([tenantId, consentType])
}

// ============================================================
// Store Excellence Audit — Tool Models
// Verknüpft mit Store (FK), aber unabhängig von anderen Tool-Models
// ============================================================

model AuditTemplate {
  id          String   @id @default(cuid())
  tenantId    String?  // null = KORE-Default, non-null = Tenant-spezifisch
  name        String
  description String?
  version     Int      @default(1)
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories AuditCategory[]
  sessions   AuditSession[]

  @@index([tenantId])
}

model AuditCategory {
  id          String        @id @default(cuid())
  templateId  String
  template    AuditTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sortOrder   Int           @default(0)
  weight      Float         @default(1.0)

  criteria AuditCriterion[]

  @@index([templateId])
}

model AuditCriterion {
  id            String        @id @default(cuid())
  categoryId    String
  category      AuditCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  sortOrder     Int           @default(0)
  isRequired    Boolean       @default(true)
  photoRequired Boolean       @default(false)

  responses AuditResponse[]

  @@index([categoryId])
}

model AuditSession {
  id            String    @id @default(cuid())
  tenantId      String
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id])
  templateId    String
  template      AuditTemplate @relation(fields: [templateId], references: [id])
  conductedBy   String
  storeLocation String?   // Optionaler Sub-Bereich im Store
  status        String    @default("DRAFT") // DRAFT, IN_PROGRESS, COMPLETED, CANCELLED
  overallScore  Float?
  notes         String?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  responses AuditResponse[]

  @@index([tenantId])
  @@index([storeId])
  @@index([tenantId, completedAt])
  @@index([conductedBy])
}

model AuditResponse {
  id           String         @id @default(cuid())
  sessionId    String
  session      AuditSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  criterionId  String
  criterion    AuditCriterion @relation(fields: [criterionId], references: [id])
  scorePercent Int?
  passed       Boolean?
  comment      String?
  photoPath    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([sessionId, criterionId])
  @@index([sessionId])
}
